# Copy this file to .env

# Demo mode: a fake Service Layer runs inside the browser, so you can use the whole form
# without SAP credentials. It is already ON when you run `npm run dev`.
# When you get real credentials, set this to false.
VITE_USE_MOCK=true

# Address of the real Service Layer (host and port, no path), used when VITE_USE_MOCK=false.
# Example: https://192.168.1.20:50000
SL_TARGET=https://localhost:50000
